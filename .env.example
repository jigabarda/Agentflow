# AgentFlow — the APP's own config. Copy to `.env` and fill in.
#
# ⚠️ AI model API keys do NOT belong here.
# Each pipeline carries its own provider key, entered in-app and stored
# encrypted (ProviderCredential). The runner passes a pipeline's key to the
# agent SDK explicitly — it must never fall back to a global env var.
# See docs/AGENTS.md and docs/SECURITY.md.

# Local SQLite database file.
DATABASE_URL="file:./dev.db"

# 32-byte key (base64) used to encrypt stored secrets + per-pipeline provider keys.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENC_KEY=""

# GitHub access for the agents' own git actions (fine-grained PAT, least privilege).
# Optional in Phase 0 — required from Phase 6 onward.
GITHUB_TOKEN=""

# Only needed if you enable the GitHub webhook endpoint. The handler must verify
# the HMAC signature on the raw body before trusting any payload.
GITHUB_WEBHOOK_SECRET=""
